{
  "name": "velvet",
  "version": "0.0.0",
  "private": true,
  "description": "Velvet — the Nostr toolkit that feels like velvet: every NIP, zero ceremony, runs anywhere TypeScript does.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter='@nostragent/*' build",
    "test": "bun test",
    "test:cov": "for p in core signers relay pool router store nips client agent; do (cd packages/$p && bun run test:cov) || exit 1; done",
    "typecheck": "bun run --filter='@nostragent/*' typecheck",
    "lint:publish": "bun run --filter='@nostragent/*' lint:publish",
    "docs:dev": "bun run --filter='@nostragent/docs' dev",
    "docs:build": "bun run --filter='@nostragent/docs' build",
    "ci:version": "changeset version && bun update",
    "ci:publish": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.3",
    "@changesets/cli": "2.31.0",
    "@types/bun": "1.3.14",
    "fast-check": "4.8.0",
    "publint": "0.3.21",
    "tsdown": "0.22.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
