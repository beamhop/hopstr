{
  "name": "@hopstr/signers",
  "version": "0.0.0",
  "description": "Velvet signers — one async Signer interface over local keys, NIP-07 extensions, NIP-46 bunkers, NIP-49 encrypted keys, and NIP-06 derivation.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint:publish": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@hopstr/core": "workspace:*",
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@scure/base": "2.2.0",
    "@scure/bip32": "2.2.0",
    "@scure/bip39": "2.2.0"
  }
}
