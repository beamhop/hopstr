{
  "name": "@hopstr/client",
  "version": "0.0.0",
  "description": "Velvet client — the high-level reactive Nostr client: Nostr.create(), optimistic publish, async-iterable subscriptions, profile cache, outbox routing on by default.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test:cov": "bun test && (bun test --coverage || true)",
    "typecheck": "tsc --noEmit",
    "lint:publish": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@hopstr/core": "workspace:*",
    "@hopstr/signers": "workspace:*",
    "@hopstr/pool": "workspace:*",
    "@hopstr/router": "workspace:*",
    "@hopstr/store": "workspace:*"
  }
}
