{
  "name": "@nostragent/store",
  "version": "0.0.0",
  "description": "Velvet store — a reactive in-memory Nostr event store: dedup, replaceable/addressable handling, NIP-09 deletes, NIP-40 expiry, async-iterable streams.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint:publish": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@nostragent/core": "workspace:*"
  }
}
