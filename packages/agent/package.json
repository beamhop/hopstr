{
  "name": "@hopstr/agent",
  "version": "0.0.0",
  "description": "Velvet's easy-mode facade — the drop-in NostrClient (post/reply/feed/DMs) and the autonomous runAgent loop, over the full @hopstr stack.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsdown",
    "test:cov": "bun test && (bun test --coverage || true)",
    "typecheck": "tsc --noEmit",
    "lint:publish": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@hopstr/core": "workspace:*",
    "@hopstr/client": "workspace:*",
    "@hopstr/nips": "workspace:*",
    "@hopstr/signers": "workspace:*"
  },
  "devDependencies": {
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@scure/base": "2.2.0"
  }
}
