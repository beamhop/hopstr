{
  "name": "@nostragent/pool",
  "version": "0.0.0",
  "description": "Velvet pool — query and subscribe across many relays with dedup, per-relay EOSE, and async-iterable subscriptions.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint:publish": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@nostragent/core": "workspace:*",
    "@nostragent/relay": "workspace:*"
  }
}
